MONGO_URI=mongodb://localhost:27017/smart-tourism
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d
PORT=5000
NODE_ENV=development

# Optional External APIs (app works in demo mode without these)
OPENAI_API_KEY=
